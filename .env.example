# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Microsoft 365 / Azure App Registration
# Required for OAuth "Connect with Microsoft 365" flow.
# Create an app registration at https://portal.azure.com > App registrations.
# Redirect URI: {your-app-url}/api/ms365/callback
# API Permissions: Mail.Read, Mail.ReadWrite, Mail.Send, User.Read (Delegated)
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
# AZURE_TENANT_ID is optional – only needed for Client Credentials fallback.
# With the OAuth flow, Tenant ID is auto-detected from the user's login.
AZURE_TENANT_ID=your-azure-tenant-id

# AI Providers
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Redis (for job queue)
REDIS_URL=redis://localhost:6379

# Worker
WORKER_API_URL=http://localhost:8000
